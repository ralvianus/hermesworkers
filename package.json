{
  "name": "hermesworkers",
  "version": "0.1.0",
  "description": "Run the Hermes personal AI assistant inside a Cloudflare Sandbox container.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev -c wrangler.local.toml",
    "deploy": "wrangler deploy -c wrangler.local.toml",
    "tail": "wrangler tail -c wrangler.local.toml",
    "secret": "wrangler secret -c wrangler.local.toml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.7.20",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.139.0"
  }
}
